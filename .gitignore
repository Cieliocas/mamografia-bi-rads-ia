# --- Python e Ambientes ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
venv_tf/
env/
.env

# --- IDEs e Editores ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# --- Dados locais (nunca versionar) ---
data/*
!data/.gitkeep
build/*
!build/.gitkeep
*.jpg
*.jpeg
*.png
# App icon assets (exceções à regra acima)
!apps/desktop/build/appicon.png
!apps/desktop/build/darwin/AppIcon.icns
!apps/frontend/public/favicon.ico
!apps/frontend/public/icon-192.png
!apps/frontend/public/icon-512.png
!apps/frontend/src/favicon.ico
!apps/frontend/src/assets/icon-192.png
!apps/frontend/src/assets/icon-512.png
# Figuras das specs: renderizadas a partir de DICOM, sem identificadores.
!specs/**/dados/*.png
*.dcm
*.dicom
# Test fixtures (small, committed for codec validation in CI).
!apps/core/internal/adapters/filesystem/testdata/*.dcm

# --- Modelos de IA ---
# Regra: nenhum peso de modelo e versionado. Os artefatos .onnx da cascata
# (classifier_hybrid.onnx ~113 MB, detector_yolo.onnx ~11 MB) sao instalados
# localmente; a rastreabilidade fica em models/CHECKSUMS.txt, que e versionado.
*.keras
*.h5
*.pt
*.pth
*.onnx
*.tflite
apps/ai-engine/models/*
!apps/ai-engine/models/.gitkeep
!apps/ai-engine/models/CHECKSUMS.txt

# --- Logs e Cache ---
*.log
.pytest_cache/
wandb/

# --- Node ---
node_modules/

# --- Go build output ---
apps/core/bin/

# --- Wails embed dir (populated by frontend build) ---
apps/desktop/dist/*
!apps/desktop/dist/.gitkeep

# --- Artefatos locais ---
*.pdf
mammografia_code.zip
Mammo BI-RADS Desktop Dev.app/
aidentify.app/

# --- Claude Code internals ---
.claude/

# --- Notas de sessão de IA (contexto interno de desenvolvimento) ---
NEXT_SESSION.md
NEXT_SESSION_*.md

# --- Relatórios e documentos internos (não públicos) ---
relatorios/

# --- Token de segurança gerado em runtime (nunca versionar) ---
.token
apps/core/.token

# --- Desktop packaging directory (local build artifacts, root-level only) ---
/desktop/

# --- Compiled Go binaries ---
apps/core/go-core
